{
  "id": "agachamento_livre",
  "nome": "Agachamento livre",
  "modalidade": "forca",
  "camera": "frontal",
  "formato": "repeticoes",
  "seg_por_rep": 3,
  "pontos_obrigatorios": [
    "quadril_e",
    "quadril_d",
    "joelho_e",
    "joelho_d"
  ],
  "medida_principal": {
    "tipo": "angulo",
    "pontos": [
      "quadril",
      "joelho",
      "tornozelo"
    ],
    "lado": "media",
    "espaco": "3d"
  },
  "medidas": {
    "joelho_2d": {
      "tipo": "angulo",
      "pontos": [
        "quadril",
        "joelho",
        "tornozelo"
      ],
      "lado": "media",
      "espaco": "2d"
    },
    "joelhos_tornozelos": {
      "tipo": "distancia",
      "pontos": [
        "joelho_e",
        "joelho_d"
      ],
      "normalizar_por": [
        "tornozelo_e",
        "tornozelo_d"
      ]
    }
  },
  "histerese": 5,
  "fases": [
    {
      "nome": "topo",
      "condicao": "medida > 155"
    },
    {
      "nome": "fundo",
      "condicao": "medida < 120"
    }
  ],
  "repeticao": [
    "topo",
    "fundo",
    "topo"
  ],
  "parcial_se": "min_medida < 140",
  "parcial_feedback": "Desça mais",
  "amplitude": {
    "extremo": "min",
    "minimo_aceito": 120,
    "ideal": 85
  },
  "duracao_minima_ms": 500,
  "fase_minima_ms": 150,
  "erros": [
    {
      "id": "valgo",
      "condicao": "vis(tornozelos) > 0.7 e dist(joelhos) < 0.7 * dist(tornozelos)",
      "fase": "fundo",
      "feedback": "Joelhos para fora",
      "pontos": ["joelho_e", "joelho_d", "quadril_e", "quadril_d", "tornozelo_e", "tornozelo_d"]
    },
    {
      "id": "amplitude_curta",
      "quando": "fim_rep",
      "condicao": "min_medida > 100",
      "feedback": "Desça mais"
    }
  ],
  "kpis": [
    "reps_validas",
    "reps_parciais",
    "amplitude_media",
    "tempo_excentrico",
    "tempo_concentrico",
    "cadencia"
  ],
  "variacao_facil": "agachamento_parcial_cadeira",
  "alternativas": {
    "joelho": "ponte_gluteo"
  },
  "instrucoes": [
    "Fique de frente para o celular, com o corpo inteiro na tela.",
    "Pés na largura dos ombros.",
    "Desça até as coxas ficarem paralelas ao chão e suba até estender os joelhos."
  ]
}
