{
  "id": "flexao_braco",
  "nome": "Flexão de braço",
  "modalidade": "forca",
  "camera": "lateral",
  "formato": "repeticoes",
  "seg_por_rep": 3,
  "pontos_obrigatorios": [
    "ombro",
    "cotovelo",
    "punho",
    "quadril"
  ],
  "medida_principal": {
    "tipo": "angulo",
    "pontos": [
      "ombro",
      "cotovelo",
      "punho"
    ],
    "lado": "visivel",
    "espaco": "2d"
  },
  "medidas": {
    "alinhamento": {
      "tipo": "angulo",
      "pontos": [
        "ombro",
        "quadril",
        "joelho"
      ],
      "lado": "visivel",
      "espaco": "2d"
    },
    "tronco": {
      "tipo": "inclinacao",
      "pontos": [
        "quadril",
        "ombro"
      ],
      "lado": "visivel"
    }
  },
  "histerese": 5,
  "fases": [
    {
      "nome": "topo",
      "condicao": "medida > 145 e tronco > 45"
    },
    {
      "nome": "fundo",
      "condicao": "medida < 110 e tronco > 45"
    }
  ],
  "repeticao": [
    "topo",
    "fundo",
    "topo"
  ],
  "parcial_se": "min_medida < 130",
  "parcial_feedback": "Desça mais o peito",
  "amplitude": {
    "extremo": "min",
    "minimo_aceito": 110,
    "ideal": 75
  },
  "duracao_minima_ms": 600,
  "erros": [
    {
      "id": "quadril_fora",
      "condicao": "vis(joelho) > 0.6 e alinhamento < 150",
      "feedback": "Alinhe o quadril",
      "pontos": ["ombro_e", "ombro_d", "quadril_e", "quadril_d", "tornozelo_e", "tornozelo_d"]
    },
    {
      "id": "amplitude_curta",
      "quando": "fim_rep",
      "condicao": "min_medida > 90",
      "feedback": "Desça mais o peito"
    }
  ],
  "kpis": [
    "reps_validas",
    "reps_parciais",
    "amplitude_media",
    "cadencia",
    "indice_tecnico"
  ],
  "variacao_facil": "flexao_joelhos",
  "instrucoes": [
    "Celular no chão, de lado para você, mostrando o corpo inteiro.",
    "Mãos no chão na linha dos ombros, corpo reto.",
    "Desça até o cotovelo dobrar 90 graus e suba."
  ]
}
